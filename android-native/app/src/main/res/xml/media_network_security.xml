<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- استثناءات البث المرصودة؛ لا يشمل الاستثناء تسجيل الدخول أو خدمات الحساب. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">new-redirect.online</domain>
        <domain includeSubdomains="true">cdnarvo.buzz</domain>
        <domain includeSubdomains="true">cdnravon.buzz</domain>
        <domain includeSubdomains="true">streamalvo.buzz</domain>
        <domain includeSubdomains="true">vidorise.buzz</domain>
        <domain includeSubdomains="true">vidunex.buzz</domain>
        <domain includeSubdomains="true">castavion.buzz</domain>
        <!-- الخادم النهائي المثبت من Location: 302 بتاريخ 2026-10-31؛ لا نسمح للنطاق كله. -->
        <domain>h33.cacheverto.buzz</domain>
    </domain-config>
</network-security-config>
