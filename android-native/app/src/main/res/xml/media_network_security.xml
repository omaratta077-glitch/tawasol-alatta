<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- HTTP playback is scoped to CDN families observed in the owner's capture. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">new-redirect.online</domain>
        <domain includeSubdomains="true">cdnarvo.buzz</domain>
    </domain-config>
</network-security-config>
